; Engine configuration file.
config_version=5

[application]

config/name="Vaelmoor"
config/description="Demo de RPG pixel art: Tortosa y el Bosque Santo."
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.055, 0.086, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Appearance="*res://scripts/autoload/Appearance.gd"
GameState="*res://scripts/autoload/GameState.gd"
Audio="*res://scripts/autoload/Audio.gd"
Transition="*res://scripts/autoload/Transition.gd"
Dialogue="*res://scripts/autoload/Dialogue.gd"
TouchControls="*res://scripts/autoload/TouchControls.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/PixelifySans.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

