extends "res://scripts/story/route.gd"

func intro() -> Array:
	return ["El pantano se seca de golpe. Delante, tierra quemada, árboles negros y estandartes rojos clavados en el barro.",
		"A lo lejos retumban tambores. Patrullas moronguls vigilan el camino."]

func sign_text() -> Array:
	return ["Un poste tallado con runas moronguls. Debajo, en letra humana: «Tortosa resiste»."]
